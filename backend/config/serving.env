# The configuration the live demo serves and the walkthrough records.
# Experiment 3 (128-token chunks, hybrid search, reranker): the best measured answers,
# 29 of 49 judged questions passed and 7 wrong refusals, against 26 and 11 without the
# reranker. Costs about 1 second more per answer on CPU. No secrets in this file.
CHUNK_SIZE=128
CHUNK_OVERLAP=16
CHUNKER=sentence
SEARCH_MODE=hybrid
RERANK_PROVIDER=local
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-12-v2
EMBED_PROVIDER=local
EMBED_MODEL=BAAI/bge-small-en-v1.5
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
