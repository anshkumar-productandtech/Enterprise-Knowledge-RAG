# The configuration the live demo serves and the walkthrough records.
# Currently experiment 2 (128-token chunks, hybrid search, no reranker): the best hit rate at
# the lowest latency. Provisional until the answer-quality pass has run. No secrets in this file.
CHUNK_SIZE=128
CHUNK_OVERLAP=16
CHUNKER=sentence
SEARCH_MODE=hybrid
RERANK_PROVIDER=none
RERANK_MODEL=
EMBED_PROVIDER=local
EMBED_MODEL=BAAI/bge-small-en-v1.5
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
