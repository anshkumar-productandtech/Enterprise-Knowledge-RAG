# Copy to backend/.env and fill in. backend/.env is git-ignored. Never commit real keys.
#
# Model IDs change often. The examples below were valid in the LlamaIndex
# integrations on 2026-11-11; check each provider's models page before a paid run.

# --- Database (Supabase Postgres or the local docker-compose Postgres) ---
# Supabase: Project Settings > Database > Connection string > "Session pooler" (port 5432).
# Do not use the transaction pooler (port 6543).
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/eka

# --- Answer model: openai | anthropic | gemini | mock ---
LLM_PROVIDER=mock
LLM_MODEL=mock
# e.g. LLM_PROVIDER=openai     LLM_MODEL=gpt-6-luna
#      LLM_PROVIDER=anthropic  LLM_MODEL=claude-haiku-5-5
#      LLM_PROVIDER=gemini     LLM_MODEL=gemini-3.7-flash

# --- Embeddings: openai | voyage | gemini | local | mock ---
EMBED_PROVIDER=mock
EMBED_MODEL=mock
# e.g. EMBED_PROVIDER=openai  EMBED_MODEL=text-embedding-3-small
#      EMBED_PROVIDER=voyage  EMBED_MODEL=voyage-4-lite
#      EMBED_PROVIDER=gemini  EMBED_MODEL=gemini-embedding-2-preview
#      EMBED_PROVIDER=local   EMBED_MODEL=BAAI/bge-small-en-v1.5   (open source, runs on CPU, no key)

# --- Reranker: cohere | local | none ---
RERANK_PROVIDER=none
RERANK_MODEL=
# e.g. RERANK_PROVIDER=cohere RERANK_MODEL=rerank-v3.5
#      RERANK_PROVIDER=local  RERANK_MODEL=Xenova/ms-marco-MiniLM-L-12-v2   (open source, runs on CPU, no key)

# --- Judge model for Ragas scoring (defaults to the answer model if blank) ---
# Use a stronger model than the answer model if you can afford it.
JUDGE_PROVIDER=
JUDGE_MODEL=

# --- API keys: only the ones your providers need ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
VOYAGE_API_KEY=
COHERE_API_KEY=

# --- Corpus ---
HANDBOOK_CONTENT_DIR=data/handbook/content

# --- Serving config (set these to the winning experiment) ---
CHUNK_SIZE=256
CHUNK_OVERLAP=32
CHUNKER=sentence
SEARCH_MODE=hybrid
TOP_K=5
CANDIDATE_K=20

# --- API hardening ---
ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=20
MAX_QUESTION_CHARS=500
# Shared secret between the Next.js server and this API. Required when deployed.
DEMO_API_TOKEN=
LOG_QUESTIONS=false
